@startuml 07-ai-services
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #1D4ED8
  FontSize 13
}
skinparam actor {
  FontSize 13
  FontStyle bold
}

title UPPMS — AI Services

actor Student
actor "Gemini API" as Gemini <<external>>

rectangle "UPPMS" {
  usecase "UC-42 Suggest Project Ideas" as UC42
  usecase "UC-43 Manage Bookmarks" as UC43
  usecase "UC-44 Generate Tasks" as UC44
  usecase "UC-27 Persist Tasks" as UC27
}

Student --> UC42
Student --> UC43
Student --> UC44
UC42 ..> Gemini
UC44 ..> Gemini
UC44 ..> UC27 : <<include>>

@enduml
