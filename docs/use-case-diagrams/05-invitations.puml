@startuml 05-invitations
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #1D4ED8
  FontSize 13
}
skinparam actor {
  FontSize 13
  FontStyle bold
}

title UPPMS — Collaboration & Invitations

actor Student
actor Supervisor

rectangle "UPPMS" {
  usecase "UC-33 Invite Supervisor" as UC33
  usecase "UC-34 Respond Supervisor Invite" as UC34
  usecase "UC-35 Invite Student" as UC35
  usecase "UC-36 Respond Student Invite" as UC36
  usecase "UC-37 Browse Invite Candidates" as UC37
}

Student --> UC33
Student --> UC35
Student --> UC36
Student --> UC37
Supervisor --> UC34

@enduml
