@startuml 10-genetic-scheduling
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #1D4ED8
  FontSize 13
}
skinparam actor {
  FontSize 13
  FontStyle bold
}

title UPPMS — Genetic Scheduling

actor Supervisor
actor "University Admin" as Admin

rectangle "UPPMS" {
  usecase "UC-51 Check Readiness" as UC51
  usecase "UC-52 Generate Schedules (GA)" as UC52
  usecase "UC-53 Approve Schedule" as UC53
  usecase "UC-54 Void Schedule" as UC54
  usecase "UC-55 Schedule History" as UC55
  usecase "UC-56 My Defense Sessions" as UC56
  usecase "UC-45 Notify Users" as UC45
}

Supervisor --> UC56
Admin --> UC51
Admin --> UC52
Admin --> UC53
Admin --> UC54
Admin --> UC55
Admin --> UC56
UC52 ..> UC51 : <<extend>>
UC53 ..> UC45 : <<include>>

@enduml
