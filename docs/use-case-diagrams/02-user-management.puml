@startuml 02-user-management
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #1D4ED8
  FontSize 13
}
skinparam actor {
  FontSize 13
  FontStyle bold
}

title UPPMS — User Management

actor Supervisor
actor "University Admin" as Admin
actor "Super Admin" as SuperAdmin

rectangle "UPPMS" {
  usecase "UC-11 Approve User" as UC11
  usecase "UC-12 Reject User" as UC12
  usecase "UC-13 Create User" as UC13
  usecase "UC-14 Update User" as UC14
  usecase "UC-15 Delete User" as UC15
  usecase "UC-16 List Pending Users" as UC16
  usecase "UC-17 Password Reset Help" as UC17
  usecase "UC-18 Toggle Supervision Availability" as UC18
}

Supervisor --> UC18
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17
SuperAdmin --> UC13
SuperAdmin --> UC14
SuperAdmin --> UC15

@enduml
