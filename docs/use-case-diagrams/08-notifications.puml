@startuml 08-notifications
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #1D4ED8
  FontSize 13
}
skinparam actor {
  FontSize 13
  FontStyle bold
}

title UPPMS — Notifications

actor Student
actor Supervisor
actor "University Admin" as Admin
actor "Super Admin" as SuperAdmin

rectangle "UPPMS" {
  usecase "UC-45 View Notifications" as UC45
  usecase "UC-46 Manage Notifications" as UC46
}

Student --> UC45
Student --> UC46
Supervisor --> UC45
Supervisor --> UC46
Admin --> UC45
Admin --> UC46
SuperAdmin --> UC45
SuperAdmin --> UC46

@enduml
