@startuml 01-authentication
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #1D4ED8
  FontSize 13
}
skinparam actor {
  FontSize 13
  FontStyle bold
}

title UPPMS — Authentication & Account

actor Guest
actor "Pending User" as Pending
actor Student
actor Supervisor
actor "University Admin" as Admin
actor "Super Admin" as SuperAdmin
actor GitHub <<external>>

rectangle "UPPMS" {
  usecase "UC-01 Register Account" as UC01
  usecase "UC-02 Login" as UC02
  usecase "UC-03 Logout" as UC03
  usecase "UC-04 View Account Status" as UC04
  usecase "UC-05 Update Profile" as UC05
  usecase "UC-06 Change Password" as UC06
  usecase "UC-07 Request Password Help" as UC07
  usecase "UC-08 Link GitHub" as UC08
  usecase "UC-09 Unlink GitHub" as UC09
  usecase "UC-10 Browse Universities" as UC10
}

Guest --> UC01
Guest --> UC02
Guest --> UC07
Guest --> UC10
Pending --> UC03
Pending --> UC04
Student --> UC03
Student --> UC05
Student --> UC06
Student --> UC08
Student --> UC09
Supervisor --> UC03
Supervisor --> UC05
Supervisor --> UC06
Supervisor --> UC08
Supervisor --> UC09
Admin --> UC03
Admin --> UC05
Admin --> UC06
Admin --> UC08
Admin --> UC09
SuperAdmin --> UC03
SuperAdmin --> UC05
SuperAdmin --> UC06
UC08 ..> GitHub
UC01 ..> UC10 : <<include>>
UC02 ..> UC04 : <<extend>>

@enduml
