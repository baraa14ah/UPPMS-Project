@startuml 09-scheduling-setup
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #1D4ED8
  FontSize 13
}
skinparam actor {
  FontSize 13
  FontStyle bold
}

title UPPMS — Scheduling Infrastructure

actor Supervisor
actor "University Admin" as Admin
actor "Super Admin" as SuperAdmin

rectangle "UPPMS" {
  usecase "UC-47 Manage Rooms" as UC47
  usecase "UC-48 Manage Academic Stages" as UC48
  usecase "UC-49 Open Availability Window" as UC49
  usecase "UC-50 Submit Availability" as UC50
}

Supervisor --> UC48
Supervisor --> UC50
Admin --> UC47
Admin --> UC48
Admin --> UC49
SuperAdmin --> UC47
SuperAdmin --> UC48
SuperAdmin --> UC49

@enduml
