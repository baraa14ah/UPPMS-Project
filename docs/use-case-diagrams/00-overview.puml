@startuml 00-overview
left to right direction
skinparam shadowing false
skinparam linetype polyline
skinparam actorStyle awesome
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #EEF4FF
  BorderColor #1D4ED8
  FontSize 13
}
skinparam actor {
  FontSize 13
  FontStyle bold
}

title UPPMS — System Overview (Module Map)

actor Guest
actor "Pending User" as Pending
actor Student
actor Supervisor
actor "University Admin" as Admin
actor "Super Admin" as SuperAdmin
actor GitHub <<external>>
actor "Gemini API" as Gemini <<external>>

rectangle "UPPMS" {
  usecase "01 Authentication\nUC-01..10" as M1
  usecase "02 User Management\nUC-11..18" as M2
  usecase "03 Projects\nUC-19..26" as M3
  usecase "04 Tasks & Comments\nUC-27..32" as M4
  usecase "05 Invitations\nUC-33..37" as M5
  usecase "06 Versions & GitHub\nUC-38..41" as M6
  usecase "07 AI Services\nUC-42..44" as M7
  usecase "08 Notifications\nUC-45..46" as M8
  usecase "09 Scheduling Setup\nUC-47..50" as M9
  usecase "10 Genetic Scheduling\nUC-51..56" as M10
  usecase "11 Platform Admin\nUC-57..60" as M11
  usecase "12 Dashboard\nUC-61..62" as M12
}

Guest --> M1
Pending --> M1
Student --> M1
Student --> M3
Student --> M4
Student --> M5
Student --> M6
Student --> M7
Student --> M8
Student --> M12
Supervisor --> M1
Supervisor --> M3
Supervisor --> M4
Supervisor --> M5
Supervisor --> M6
Supervisor --> M8
Supervisor --> M9
Supervisor --> M10
Supervisor --> M12
Admin --> M1
Admin --> M2
Admin --> M3
Admin --> M4
Admin --> M8
Admin --> M9
Admin --> M10
Admin --> M12
SuperAdmin --> M1
SuperAdmin --> M2
SuperAdmin --> M3
SuperAdmin --> M9
SuperAdmin --> M11
SuperAdmin --> M12
M6 ..> GitHub
M7 ..> Gemini

@enduml
